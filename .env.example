# --- Database (required for the web app) ---
# Postgres connection string. Free options: Neon (neon.tech) or Supabase.
DATABASE_URL=postgres://user:password@host:5432/leadscout

# --- Auth: Clerk (required for the web app) ---
# Create a free app at clerk.com. In development, Clerk can also run keyless.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments: Paystack (required for credit packs) ---
# Get keys at dashboard.paystack.com (use test keys while developing).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Country gate (comma-separated ISO codes). Leave unset to allow everyone (dev).
# ALLOWED_COUNTRIES=NG
# Emails that can always sign in and open /admin. When set, everyone else must
# be added on the /admin page. Leave unset to allow every signed-in user.
# ADMIN_EMAILS=

# --- Optional enrichment (CLI only for now; web users get the Basic engine) ---
# SerpApi powers CLI Google Maps ratings AND the web app's on-demand
# decision-maker lookup (finds publicly indexed LinkedIn profile URLs via
# Google). Without it, the "Find decision makers" action is disabled.
SERPAPI_KEY=
ENRICH_CONCURRENCY=3

# --- Background searches: Inngest ---
# Searches run as background jobs so leaving the page never loses leads.
# On Vercel, the Inngest integration sets these two for you.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Local only: talk to the dev server started with `npx inngest-cli@latest dev`.
# INNGEST_DEV=1
# State/niche pairs searched at once (1-6). Overpass throttles per IP.
# SEARCH_PARALLEL_NICHES=3

# --- Mailboxes (encrypts each account's app password at rest) ---
# 32 random bytes, base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_ENCRYPTION_KEY=
