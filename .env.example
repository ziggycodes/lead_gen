# --- Database (required for the web app) ---
# Postgres connection string. Free options: Neon (neon.tech) or Supabase.
DATABASE_URL=postgres://user:password@host:5432/leadscout

# --- Auth: Clerk (required for the web app) ---
# Create a free app at clerk.com. In development, Clerk can also run keyless.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Payments: Paystack (required for credit packs) ---
# Get keys at dashboard.paystack.com (use test keys while developing).
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Country gate (comma-separated ISO codes). Leave unset to allow everyone (dev).
# ALLOWED_COUNTRIES=NG

# --- Optional enrichment (CLI only for now; web users get the Basic engine) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
# SerpApi powers CLI Google Maps ratings AND the web app's on-demand
# decision-maker lookup (finds publicly indexed LinkedIn profile URLs via
# Google). Without it, the "Find decision makers" action is disabled.
SERPAPI_KEY=
ENRICH_CONCURRENCY=3
